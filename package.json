{
	"name": "fnx-bus",
	"version": "0.1.0",
	"description": "多 agent 消息总线：结构化契约校验 + 授权闸门 + 文件队列。一个 pi 扩展，可装可不装，与各 agent 源码解耦。",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-skill",
		"agent",
		"multi-agent",
		"agent-to-agent",
		"message-bus",
		"authorization-gate"
	],
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HwJhx/fnx_bus.git"
	},
	"homepage": "https://github.com/HwJhx/fnx_bus#readme",
	"bugs": {
		"url": "https://github.com/HwJhx/fnx_bus/issues"
	},
	"files": [
		"extensions",
		"skills",
		"roles.example.json",
		"LICENSE",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./extensions"
		],
		"skills": [
			"./skills"
		]
	},
	"scripts": {
		"test": "vitest --run",
		"typecheck": "tsgo --noEmit",
		"check": "biome check --write --error-on-warnings . && tsgo --noEmit && vitest --run"
	},
	"dependencies": {
		"typebox": "1.1.38"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "0.79.10",
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
